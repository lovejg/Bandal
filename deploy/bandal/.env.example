# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다(서버에는 배포 작업이 GitHub Secrets로 만들어 넣는다)
# 비밀값은 길고 무작위로: head -c 48 /dev/urandom | base64

# 어떤 이미지를 띄울지. 비우면 로컬에서 build한 bandal-backend:local, bandal-web:local
IMAGE_PREFIX=
IMAGE_TAG=

DB_USERNAME=bandal
DB_PASSWORD=
JWT_SECRET=

# 운영은 Resend SMTP(smtp.resend.com, 587, 사용자 resend, 비밀번호는 API 키)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 메일 인증 링크의 앞부분. 예: https://bandal.example.com
APP_BASE_URL=

# 여기부터는 앱이 아니라 backup.sh가 읽는다
# R2 버킷 주소: https://<Cloudflare 계정 ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
# 그 버킷 하나에만 읽고 쓸 수 있는 R2 API 토큰
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# healthchecks.io의 감시 주소. 비우면 알리지 않는다
BACKUP_PING_URL=
